// src/components/RoomScheduler.jsx
import React, { useEffect, useState } from "react";

/*
  Updated RoomScheduler:
  - Renders rooms x 30-min time slots with exact "HH:MM" labels (e.g., "09:00", "09:30").
  - Fixed classes (from timetable.json OR events with fixed=true) are red.
  - Other admin-added events (not fixed) are blue.
  - Provides an Admin panel to add events; events are saved to localStorage and merged with events.json.
  - Selected date auto-updates to the current date every 30 seconds so the view stays on "today".
*/

function pad(n){ return n.toString().padStart(2,'0'); }
function formatLocalDate(d){
  // return YYYY-MM-DD for local date (avoids UTC shift)
  const y = d.getFullYear();
  const m = pad(d.getMonth()+1);
  const day = pad(d.getDate());
  return `${y}-${m}-${day}`;
}

function hhmm(min){
  const h = Math.floor(min/60); const m = min%60;
  return `${pad(h)}:${pad(m)}`;
}
function timeStrToMinutes(t){
  if(!t) return null;
  if(typeof t === "number") return t;
  const parts = String(t).split(":").map(x=>parseInt(x,10));
  if(parts.length>=2 && !isNaN(parts[0]) && !isNaN(parts[1])) return parts[0]*60 + parts[1];
  return null;
}
function minutesToTime(min){
  const h = Math.floor(min/60), m = min%60;
  return `${pad(h)}:${pad(m)}:00`;
}
function getDayName(date){
  const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  return days[date.getDay()];
}

export default function RoomScheduler(){
  const [timetable, setTimetable] = useState(null);
  const [eventsFromFile, setEventsFromFile] = useState([]);
  const [localEvents, setLocalEvents] = useState([]);
  const [selectedDate, setSelectedDate] = useState(new Date());
  const [timeSlots, setTimeSlots] = useState([]);
  const [isAdmin, setIsAdmin] = useState(false);
  const [form, setForm] = useState({room:"", date:"", start:"09:00", end:"09:30", title:"", fixed:true});
  const [error, setError] = useState(null);

  useEffect(()=>{
    // auto-update today's date every 30s so the UI keeps current date
    const tick = setInterval(()=> setSelectedDate(new Date()), 30000);
    return ()=> clearInterval(tick);
  },[]);

  useEffect(()=>{
    fetch("/data/timetable.json").then(r=>{
      if(!r.ok) throw new Error("Failed to load /data/timetable.json");
      return r.json();
    }).then(j=>{
      setTimetable(j);
      // derive time slots from j.times (already in HH:MM form)
      if(Array.isArray(j.times) && j.times.length>0){
        // ensure each slot is "HH:MM"
        const slots = j.times.map(s => {
          const parts = String(s).split(":");
          const hh = parseInt(parts[0]||0,10), mm = parseInt(parts[1]||0,10);
          return `${pad(hh)}:${pad(mm)}`;
        });
        setTimeSlots(slots);
      } else {
        // fallback
        const s = [];
        for(let m=9*60;m<20*60;m+=30) s.push(hhmm(m));
        setTimeSlots(s);
      }
    }).catch(e=>setError(e.message));

    // load events.json (optional)
    fetch("/data/events.json").then(r=>{
      if(!r.ok) return [];
      return r.json();
    }).then(ev=>{
      if(Array.isArray(ev)){
        // normalize: ensure fixed:true for events that should be fixed
        const norm = ev.map(x=> ({...x, fixed: x.fixed===undefined ? true : !!x.fixed}));
        setEventsFromFile(norm);
      }
    }).catch(()=>{});

    // load persisted local events from localStorage
    try{
      const raw = localStorage.getItem("custom_events_v1");
      if(raw){
        const arr = JSON.parse(raw);
        setLocalEvents(arr);
      }
    }catch(err){}
  },[]);

  function persistLocalEvents(arr){
    try{
      localStorage.setItem("custom_events_v1", JSON.stringify(arr));
      setLocalEvents(arr);
    }catch(err){
      console.error("Failed to save events", err);
    }
  }

  if(error) return <div style={{color:"red"}}>Error: {error}</div>;
  if(!timetable) return <div>Loading timetable...</div>;

  const dayName = getDayName(selectedDate);

  // merge events: eventsFromFile (treated as fixed by default) + localEvents
  const allEvents = [...(eventsFromFile||[]), ...(localEvents||[])];

  function fixedFor(roomObj, slot){
    // slot is like "09:00"
    // check timetable fixed classes first
    if(roomObj.slots && roomObj.slots[slot]) return {title: roomObj.slots[slot], fixed:true};
    // check events that are fixed and match weekday and slot
    for(const ev of allEvents){
      const evFixed = ev.fixed===undefined ? true : !!ev.fixed;
      if(!evFixed) continue;
      if(String(ev.room) !== String(roomObj.room)) continue;
      // event's start/end may be dates or just times
      // accept start like "2025-11-26T09:30" or "09:30"
      let sMin = null, eMin = null;
      if(ev.start.includes("T")){
        try{
          const d = new Date(ev.start);
          if(d.getDay() !== selectedDate.getDay()) continue;
          sMin = d.getHours()*60 + d.getMinutes();
        }catch(e){ continue; }
      } else {
        sMin = timeStrToMinutes(ev.start);
      }
      if(ev.end.includes("T")){
        try{ const d = new Date(ev.end); eMin = d.getHours()*60 + d.getMinutes(); }catch(e){}
      } else {
        eMin = timeStrToMinutes(ev.end);
      }
      if(sMin===null || eMin===null) continue;
      const slotMin = timeStrToMinutes(slot);
      if(slotMin===null) continue;
      if(!(slotMin+30 <= sMin || slotMin >= eMin)){
        return {title: ev.title || "Event", fixed:true};
      }
    }
    return null;
  }

  function eventsFor(roomName, slot){
    const res = [];
    for(const ev of allEvents){
      const evFixed = ev.fixed===undefined ? true : !!ev.fixed;
      if(evFixed) continue; // skip fixed ones here
      if(String(ev.room) !== String(roomName)) continue;
      let sMin = null, eMin = null;
      if(ev.start.includes("T")){
        try{ const d=new Date(ev.start); if(d.getDay() !== selectedDate.getDay()) continue; sMin = d.getHours()*60 + d.getMinutes(); }catch(e){ continue; }
      } else { sMin = timeStrToMinutes(ev.start); }
      if(ev.end.includes("T")){ try{ const d=new Date(ev.end); eMin = d.getHours()*60 + d.getMinutes(); }catch(e){} } else { eMin = timeStrToMinutes(ev.end); }
      if(sMin===null || eMin===null) continue;
      const slotMin = timeStrToMinutes(slot);
      if(slotMin===null) continue;
      if(!(slotMin+30 <= sMin || slotMin >= eMin)){
        res.push(ev);
      }
    }
    return res;
  }

  // Admin form handlers
  function handleAddEvent(e){
    e.preventDefault();
    const ev = {
      room: form.room,
      start: form.date && form.start && form.date.length ? `${form.date}T${form.start}:00` : form.start,
      end: form.date && form.end && form.date.length ? `${form.date}T${form.end}:00` : form.end,
      title: form.title,
      fixed: !!form.fixed
    };
    const next = [...localEvents, ev];
    persistLocalEvents(next);
    // reset form title
    setForm({...form, title:""});
  }

  // Save/export button to download merged events as JSON (for admin to copy back to repo)
  function downloadEvents(){
    const blob = new Blob([JSON.stringify(allEvents, null, 2)], {type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "events-export.json";
    a.click();
    URL.revokeObjectURL(url);
  }

  return (
    <div style={{padding:20}}>
      <h2>Room / Time Timetable</h2>
      <div style={{marginBottom:12, display:"flex", gap:12, alignItems:"center"}}>
        <div>
          <label style={{marginRight:8}}>Select date:</label>
          <input type="date" value={formatLocalDate(selectedDate)}
            onChange={e=>setSelectedDate(new Date(e.target.value + 'T00:00'))} />
          <button style={{marginLeft:8}} onClick={()=>setSelectedDate(new Date())}>Today</button>
        </div>
        <div>Showing schedule for: <strong>{getDayName(selectedDate)}</strong></div>
        <div style={{marginLeft:"auto"}}>
          <label><input type="checkbox" checked={isAdmin} onChange={e=>setIsAdmin(e.target.checked)} /> Admin mode</label>
        </div>
      </div>

      <div style={{overflowX:"auto"}}>
        <table style={{borderCollapse:"collapse", minWidth:800}}>
          <thead>
            <tr>
              <th style={{position:"sticky", left:0, background:"#fff", zIndex:5, border:"1px solid #ddd", padding:8}}>Room / Time</th>
              {timeSlots.map((t,i)=>(
                <th key={i} style={{border:"1px solid #ddd", padding:8, whiteSpace:"nowrap", textAlign:"center"}}>{t}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {timetable.rooms.map((roomObj, rIdx)=>(
              <tr key={rIdx}>
                <td style={{position:"sticky", left:0, background:"#fafafa", border:"1px solid #ddd", padding:8, fontWeight:600}}>{roomObj.room}</td>
                {timeSlots.map((t, cIdx)=>{
                  const fixed = fixedFor(roomObj, t);
                  const evs = eventsFor(roomObj.room, t);
                  return (
                    <td key={cIdx} style={{border:"1px solid #eee", padding:6, minWidth:80, height:46, verticalAlign:"top"}}>
                      { fixed ? (
                        <div style={{background:"#ffdddd", color:"#900", padding:"4px 6px", borderRadius:4, height:"100%"}}>
                          {String(fixed.title || fixed)}
                        </div>
                      ) : evs.length>0 ? (
                        <div style={{background:"#dde8ff", color:"#024", padding:"4px 6px", borderRadius:4}}>
                          {evs.map((e, idx)=>(<div key={idx}>{e.title}</div>))}
                        </div>
                      ) : null }
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style={{marginTop:12}}>
        <small><strong>Legend:</strong> <span style={{background:"#ffdddd", padding:"2px 6px", borderRadius:3}}>Fixed class</span> <span style={{marginLeft:8, background:"#dde8ff", padding:"2px 6px", borderRadius:3}}>Admin event</span></small>
      </div>

      {isAdmin && (
        <div style={{marginTop:20, border:"1px solid #ddd", padding:12, borderRadius:6, maxWidth:720}}>
          <h3>Admin: Add Event</h3>
          <form onSubmit={handleAddEvent} style={{display:"grid", gridTemplateColumns:"1fr 1fr", gap:8}}>
            <label>Room
              <select required value={form.room} onChange={e=>setForm({...form, room:e.target.value})}>
                <option value="">Select room</option>
                {timetable.rooms.map(r=>(<option key={r.room} value={r.room}>{r.room}</option>))}
              </select>
            </label>
            <label>Date
              <input type="date" value={form.date} onChange={e=>setForm({...form, date:e.target.value})} />
            </label>
            <label>Start time
              <input type="time" step="1800" value={form.start} onChange={e=>setForm({...form, start:e.target.value})} />
            </label>
            <label>End time
              <input type="time" step="1800" value={form.end} onChange={e=>setForm({...form, end:e.target.value})} />
            </label>
            <label style={{gridColumn:"1 / 3"}}>Title
              <input required value={form.title} onChange={e=>setForm({...form, title:e.target.value})} />
            </label>
            <label>
              <input type="checkbox" checked={form.fixed} onChange={e=>setForm({...form, fixed:e.target.checked})} /> Fixed (shows as red)
            </label>
            <div style={{display:"flex", gap:8, alignItems:"center"}}>
              <button type="submit">Add event</button>
              <button type="button" onClick={()=>{ setForm({room:"",date:"",start:"09:00",end:"09:30",title:"",fixed:true}) }}>Reset</button>
              <button type="button" onClick={downloadEvents}>Export events JSON</button>
            </div>
          </form>

          <div style={{marginTop:12}}>
            <h4>Existing local events</h4>
            <ul>
              {localEvents.map((e, i)=>(<li key={i}>{e.title} — {e.room} — {e.start} to {e.end} — {e.fixed ? "Fixed":"Admin"}</li>))}
            </ul>
            <button onClick={()=>{ localStorage.removeItem("custom_events_v1"); setLocalEvents([]); }}>Clear local events</button>
          </div>
        </div>
      )}
    </div>
  );
}